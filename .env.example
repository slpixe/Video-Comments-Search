# Public OAuth client ID; never put client secrets in VITE_ variables.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Public browser key: restrict to YouTube Data API v3 and exact website referrers.
VITE_YOUTUBE_API_KEY=your-restricted-youtube-api-key
# Set to /Video-Comments-Search/ only for the legacy GitHub Pages path.
VITE_BASE_PATH=/
